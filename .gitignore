# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~
.venv/

# Local GAL workflow state (keep .dev/project.md tracked)
.dev/*
!.dev/project.md

# Secrets (never commit these)
*.key
*.pem
openclaw.json

# Local overrides (fork and customize)
# Keep machine-specific files out of source control.
# Example: commit config.example.env, ignore config.local.env.
config.local.env
mcp.local.json
xmachine.config.json
commands/*/SKILL.local.md

# Local temporary outputs, caches, and sandboxes
.tmp/

# Generated provider plugin artifacts
dist/

# Rust build output
/target/
**/target/

# Release scratch
/release-scratch/