#!/usr/bin/env sh
# GAL commit-msg hook — delegates to the `gal commit-msg` Rust command.
#
# Non-destructive contract: `gal commit-msg <file>` preserves an existing author
# message and only fills a blank one. It never overwrites what you wrote.
#
# Installation:
#   cp hooks/commit-msg .git/hooks/commit-msg
#   chmod +x .git/hooks/commit-msg
#
# Or set core.hooksPath to this directory (see Update-Personalization).

set -eu

if command -v gal >/dev/null 2>&1; then
	exec gal commit-msg "$1"
fi

# `gal` is not on PATH (binary not installed yet): leave the author's message
# untouched. We deliberately do NOT fall back to overwriting the message — the
# retired PS/Bash helpers used `> "$1"`, which clobbered every commit message.
exit 0
