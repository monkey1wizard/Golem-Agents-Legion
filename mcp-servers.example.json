{
  "version": 1,
  "servers": {
    "context7": {
      "description": "Library and framework documentation search.",
      "providers": {
        "vscode": {
          "key": "upstash/context7",
          "enabled": true,
          "config": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp"
          }
        },
        "gemini": {
          "key": "context7",
          "enabled": true,
          "config": {
            "httpUrl": "https://mcp.context7.com/mcp"
          }
        },
        "codex": {
          "key": "context7",
          "enabled": true,
          "config": {
            "url": "https://mcp.context7.com/mcp"
          }
        }
      }
    },
    "fetch": {
      "description": "Fetch and summarize web pages.",
      "providers": {
        "vscode": {
          "key": "fetch",
          "enabled": true,
          "config": {
            "command": "uvx",
            "args": [
              "mcp-server-fetch"
            ]
          }
        },
        "gemini": {
          "key": "fetch",
          "enabled": true,
          "config": {
            "command": "uvx",
            "args": [
              "mcp-server-fetch"
            ]
          }
        },
        "codex": {
          "key": "fetch",
          "enabled": true,
          "config": {
            "command": "uvx",
            "args": [
              "mcp-server-fetch"
            ]
          }
        }
      }
    },
    "filesystem": {
      "description": "Workspace and vault file access.",
      "providers": {
        "vscode": {
          "key": "filesystem",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-filesystem",
              "${MCP_FILESYSTEM_PATHS[]}"
            ]
          }
        },
        "gemini": {
          "key": "filesystem",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-filesystem",
              "${MCP_FILESYSTEM_PATHS[]}"
            ]
          }
        },
        "codex": {
          "key": "filesystem",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-filesystem",
              "${MCP_FILESYSTEM_PATHS[]}"
            ]
          }
        }
      }
    },
    "memory": {
      "description": "Persistent MCP memory store.",
      "providers": {
        "vscode": {
          "key": "memory",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-memory"
            ],
            "env": {
              "MEMORY_FILE_PATH": "${MCP_MEMORY_FILE_PATH}"
            }
          }
        },
        "gemini": {
          "key": "memory",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-memory"
            ],
            "env": {
              "MEMORY_FILE_PATH": "${MCP_MEMORY_FILE_PATH}"
            }
          }
        },
        "codex": {
          "key": "memory",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-memory"
            ],
            "env": {
              "MEMORY_FILE_PATH": "${MCP_MEMORY_FILE_PATH}"
            }
          }
        }
      }
    },
    "microsoftdocs": {
      "description": "Microsoft Learn documentation MCP.",
      "providers": {
        "vscode": {
          "key": "microsoftdocs/mcp",
          "enabled": true,
          "config": {
            "type": "http",
            "url": "https://learn.microsoft.com/api/mcp"
          }
        },
        "gemini": {
          "key": "Microsoft Learn MCP Server",
          "enabled": true,
          "config": {
            "httpUrl": "https://learn.microsoft.com/api/mcp"
          }
        },
        "codex": {
          "key": "microsoftdocs",
          "enabled": true,
          "config": {
            "url": "https://learn.microsoft.com/api/mcp"
          }
        }
      }
    },
    "puppeteer": {
      "description": "Headless browser automation.",
      "providers": {
        "vscode": {
          "key": "puppeteer",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-puppeteer"
            ]
          }
        },
        "gemini": {
          "key": "puppeteer",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-puppeteer"
            ]
          }
        },
        "codex": {
          "key": "puppeteer",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-puppeteer"
            ]
          }
        }
      }
    },
    "imagefetch": {
      "description": "Image-aware web fetch MCP.",
      "providers": {
        "vscode": {
          "key": "imageFetch",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@kazuph/mcp-fetch"
            ]
          }
        },
        "gemini": {
          "key": "imageFetch",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@kazuph/mcp-fetch"
            ]
          }
        },
        "codex": {
          "key": "imagefetch",
          "enabled": true,
          "config": {
            "command": "npx",
            "args": [
              "-y",
              "@kazuph/mcp-fetch"
            ]
          }
        }
      }
    },
    "graphify": {
      "description": "Knowledge graph query server for architecture-aware planning and review.",
      "providers": {
        "vscode": {
          "key": "graphify",
          "enabled": false,
          "config": {
            "command": "python",
            "args": [
              "-m",
              "graphify.serve",
              "graphify-out/graph.json"
            ]
          }
        },
        "gemini": {
          "key": "graphify",
          "enabled": false,
          "config": {
            "command": "python",
            "args": [
              "-m",
              "graphify.serve",
              "graphify-out/graph.json"
            ]
          }
        },
        "codex": {
          "key": "graphify",
          "enabled": false,
          "config": {
            "command": "python",
            "args": [
              "-m",
              "graphify.serve",
              "graphify-out/graph.json"
            ]
          }
        }
      }
    },
    "github": {
      "description": "GitHub MCP via the Copilot endpoint.",
      "providers": {
        "vscode": {
          "key": "github/github-mcp-server",
          "enabled": true,
          "config": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/"
          }
        },
        "gemini": {
          "key": "github",
          "enabled": false,
          "config": {
            "httpUrl": "https://api.githubcopilot.com/mcp/"
          }
        },
        "codex": {
          "key": "github",
          "enabled": false,
          "config": {
            "url": "https://api.githubcopilot.com/mcp/"
          }
        }
      }
    },
    "chrome-devtools": {
      "description": "Chrome DevTools MCP for local browser inspection.",
      "providers": {
        "vscode": {
          "key": "chromedevtools/chrome-devtools-mcp",
          "enabled": true,
          "config": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "chrome-devtools-mcp@latest",
              "--headless",
              "false",
              "--isolated",
              "false",
              "--channel",
              "stable"
            ]
          }
        },
        "gemini": {
          "key": "chrome-devtools",
          "enabled": false,
          "config": {
            "command": "npx",
            "args": [
              "chrome-devtools-mcp@latest"
            ]
          }
        },
        "codex": {
          "key": "chrome-devtools",
          "enabled": false,
          "config": {
            "command": "npx",
            "args": [
              "chrome-devtools-mcp@latest"
            ]
          }
        }
      }
    },
    "obsidian": {
      "description": "Obsidian Local REST API MCP bridge.",
      "providers": {
        "vscode": {
          "key": "obsidian-mcp-server",
          "enabled": false,
          "requiredEnv": [
            "OBSIDIAN_API_KEY",
            "OBSIDIAN_BASE_URL"
          ],
          "config": {
            "command": "npx",
            "args": [
              "obsidian-mcp-server"
            ],
            "env": {
              "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
              "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL}",
              "OBSIDIAN_VERIFY_SSL": "${OBSIDIAN_VERIFY_SSL}",
              "OBSIDIAN_ENABLE_CACHE": "${OBSIDIAN_ENABLE_CACHE}"
            }
          }
        },
        "gemini": {
          "key": "obsidian-mcp-server",
          "enabled": true,
          "requiredEnv": [
            "OBSIDIAN_API_KEY",
            "OBSIDIAN_BASE_URL"
          ],
          "config": {
            "command": "npx",
            "args": [
              "obsidian-mcp-server"
            ],
            "env": {
              "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
              "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL}",
              "OBSIDIAN_VERIFY_SSL": "${OBSIDIAN_VERIFY_SSL}",
              "OBSIDIAN_ENABLE_CACHE": "${OBSIDIAN_ENABLE_CACHE}"
            }
          }
        },
        "codex": {
          "key": "obsidian",
          "enabled": false,
          "requiredEnv": [
            "OBSIDIAN_API_KEY",
            "OBSIDIAN_BASE_URL"
          ],
          "config": {
            "command": "npx",
            "args": [
              "obsidian-mcp-server"
            ],
            "env": {
              "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
              "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL}",
              "OBSIDIAN_VERIFY_SSL": "${OBSIDIAN_VERIFY_SSL}",
              "OBSIDIAN_ENABLE_CACHE": "${OBSIDIAN_ENABLE_CACHE}"
            }
          }
        }
      }
    }
  }
}