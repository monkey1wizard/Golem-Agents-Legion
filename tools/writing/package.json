{
  "name": "@golem-agents-legion/writing-toolchain",
  "private": true,
  "version": "0.1.0",
  "description": "Pinned textlint toolchain for GAL writing checks",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "check": "node check.mjs --required",
    "check:files": "node check.mjs --locale en-US --files",
    "check:terms": "node terms.mjs --check",
    "mcp": "textlint --mcp"
  },
  "dependencies": {
    "textlint": "15.2.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-write-good": "2.0.0"
  }
}
