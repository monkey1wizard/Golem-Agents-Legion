# Golem Agents Legion — Local Configuration
# Copy this file to config.local.env and fill in your paths.
# config.local.env is git-ignored and will not be committed.
#
# These values replace <PLACEHOLDER> tokens in tracked files via
# the git smudge/clean filter registered by Setup-Machine.
#
# Rules:
#   - Use absolute paths (no trailing slash)
#   - Do NOT quote values
#   - Lines starting with # are comments
#   - Empty values are ignored (placeholder stays as-is)

# Absolute path to your Obsidian vault
OBSIDIAN_VAULT=

# Vault name as shown in Obsidian's vault switcher
OBSIDIAN_VAULT_NAME=

# Optional Guide path inside the vault. Leave empty to use generic mode.
# Use a vault-relative path such as Guide.md
OBSIDIAN_GUIDE_PATH=

# Guide resolution mode: auto, guide, or generic
OBSIDIAN_GUIDE_MODE=auto

# Vault-relative directory for private research captures
OBSIDIAN_PRIVATE_RESEARCH_DIR=

# Vault-relative directory for work diaries
OBSIDIAN_DIARY_DIR=

# Vault-relative directory for scratch logs
OBSIDIAN_SCRATCH_DIR=

# Vault-relative directory for diary archives
OBSIDIAN_ARCHIVE_DIR=

# Default durable research destination: repo, private, knowledge, or none
RESEARCH_DEFAULT_DEST=repo

# Working hours are opt-in. Set to true to enable wrap-up reminders and hard-stop enforcement.
WORKING_HOURS_ENABLED=false

# Workday window in 24-hour HH:MM format
WORKDAY_START=
WORKDAY_END=

# Wrap-up Time and Hard Stop in 24-hour HH:MM format
WRAP_UP_TIME=
HARD_STOP_TIME=

# Path to your obsidian-note-taking-assistant clone (local-first-search)
LOCAL_SEARCH_PROJECT=

# Path where GAL skills are installed (e.g. ~/.copilot/skills)
GAL_SKILLS=

# Temporary directory for script output
TEMP_DIR=

# Comma-separated filesystem roots for MCP filesystem server.
# Leave empty to default to the parent directory of this GAL repo,
# plus OBSIDIAN_VAULT when that path is set.
MCP_FILESYSTEM_PATHS=

# Path to the MCP memory JSON file
MCP_MEMORY_FILE_PATH=

# Context7 API key if you use a provider/runtime that requires it
CONTEXT7_API_KEY=

# ─── Node Identity (B+C dispatch design) ────────────────────────────────────
# Copy to config.local.env and fill in. Do NOT commit config.local.env.
# GAL_NODE_ID          : unique identifier for this machine (e.g. mac-mini, win11-pc)
# GAL_NODE_CAPABILITIES: comma-separated capability tags used for routing/scheduling.
#                        Common workflow tags: planning,review,dispatch,implement,test
#                        Common machine tags: persistent,transient,gpu,local,remote
GAL_NODE_ID=
GAL_NODE_CAPABILITIES=
