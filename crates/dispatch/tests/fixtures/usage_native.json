        "{\"type\":\"step_finish\",\"sessionID\":\"o-1\",\"part\":{\"tokens\":{\"input\":1000,\"output\":200,\"reasoning\":20,\"cache\":{\"read\":800,\"write\":50}},\"cost\":0.01}}",
        "{\"type\":\"step_finish\",\"sessionID\":\"o-1\",\"part\":{\"tokens\":{\"input\":300,\"output\":40,\"reasoning\":0,\"cache\":{\"read\":0,\"write\":0}}}}"
      ],
      "capability": "mapped",
      "expect": [
        {
          "source": { "source_version": "opencode.run.step_finish.v1" },
          "tokens": {
            "input": { "count": { "value": { "state": "reported", "value": 1300 }, "semantics": "delta", "descendants": "own" }, "relation": { "kind": "exclusive" } },
            "output": { "count": { "value": { "state": "reported", "value": 240 } } },
            "cached_input": { "count": { "value": { "state": "reported", "value": 800 } } },
            "cache_write": { "count": { "value": { "state": "reported", "value": 50 } } }
          },
          "cost": { "value": { "state": "unsupported" } }
        }
      ]
    },
    {
      "name": "opencode_trailing_error_keeps_completed_steps_partial",
      "executor": "opencode",
      "schema": "opencode.run.step_finish",
      "version": 1,
      "provenance": "OpenCode run --format json stream whose last event is an error after one completed step.",
      "stdout_lines": [
        "{\"type\":\"step_finish\",\"sessionID\":\"o-2\",\"part\":{\"tokens\":{\"input\":1000,\"output\":200,\"reasoning\":0,\"cache\":{\"read\":0,\"write\":0}}}}",
        "{\"type\":\"error\",\"sessionID\":\"o-2\",\"error\":{\"name\":\"APIError\"}}"
      ],
      "capability": "mapped",
      "expect": [
        {
          "tokens": {
            "input": { "count": { "value": { "state": "partial", "value": 1000 } } },
            "output": { "count": { "value": { "state": "partial", "value": 200 } } }
          }
        }
      ]
    }
  ]
}
