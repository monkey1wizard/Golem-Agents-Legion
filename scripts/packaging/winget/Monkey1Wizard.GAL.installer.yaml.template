  InstallerSha256: "{{SHA256_WIN_X64}}"
- Architecture: arm64
  InstallerUrl: "https://github.com/monkey1wizard/golem-agents-legion/releases/download/{{VERSION}}/gal-{{VERSION}}-windows-arm64.zip"
  InstallerSha256: "{{SHA256_WIN_ARM64}}"
  NestedInstallerFiles:
  - RelativeFilePath: "gal-{{VERSION}}-windows-arm64.exe"
    PortableCommandAlias: gal
ManifestType: installer
ManifestVersion: 1.6.0
