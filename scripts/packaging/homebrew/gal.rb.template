# Homebrew formula template for GAL — Golem Agents Legion bootstrap CLI
# Placeholders (fill in from checksums.txt after publishing the GitHub Release):
#   {{VERSION}}          — exact GitHub Release tag (e.g. v0.1.0)
#   {{SHA256_DARWIN_X64}}   — SHA-256 of gal-{{VERSION}}-darwin-x64.tar.gz
#   {{SHA256_DARWIN_ARM64}} — SHA-256 of gal-{{VERSION}}-darwin-arm64.tar.gz
#   {{SHA256_LINUX_X64}}    — SHA-256 of gal-{{VERSION}}-linux-x64.tar.gz
#   {{SHA256_LINUX_ARM64}}  — SHA-256 of gal-{{VERSION}}-linux-arm64.tar.gz
#
# Generated by: gal release --homebrew
# Submit to: https://github.com/monkey1wizard/homebrew-tap (monkey1wizard/tap)
class Gal < Formula
  desc "GAL — Golem Agents Legion bootstrap CLI"
  homepage "https://github.com/monkey1wizard/golem-agents-legion"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/monkey1wizard/golem-agents-legion/releases/download/{{VERSION}}/gal-{{VERSION}}-darwin-arm64.tar.gz"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    else
      url "https://github.com/monkey1wizard/golem-agents-legion/releases/download/{{VERSION}}/gal-{{VERSION}}-darwin-x64.tar.gz"
      sha256 "{{SHA256_DARWIN_X64}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/monkey1wizard/golem-agents-legion/releases/download/{{VERSION}}/gal-{{VERSION}}-linux-arm64.tar.gz"
      sha256 "{{SHA256_LINUX_ARM64}}"
    else
      url "https://github.com/monkey1wizard/golem-agents-legion/releases/download/{{VERSION}}/gal-{{VERSION}}-linux-x64.tar.gz"
      sha256 "{{SHA256_LINUX_X64}}"
    end
  end

  def install
    # Install the canonical binary as bin/gal.
    # The archive contains the versioned binary name (e.g. gal-v0.1.0-darwin-arm64).
    # Homebrew renames it to gal at install time only; no ~/.gal/ seeding.
    bin.install Dir["gal-*[^/]"].first => "gal"

    # Install the GAL plugin source to share/gal/ (FHS layout).
    # resolve_packaged_source_root() in gal-engine locates the source via the
    # FHS strategy: binary at <prefix>/bin/gal → source at <prefix>/share/gal.
    # After `brew install`, run `gal install` to converge ~/.gal/ surfaces.
    %w[agents skills commands conventions workflows templates].each do |dir|
      (share/"gal").install dir if File.directory?(dir)
    end
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/gal --version")
    # Verify the plugin source was installed (T-008: package-manager install convergence).
    assert_predicate share/"gal/skills", :directory?
    assert_predicate share/"gal/agents", :directory?
  end
end
